# ─────────────────────────────────────────────────────────────────────────────
# SOC Sentinel — configuration
# Copier ce fichier en .env puis renseigner les valeurs réelles.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Secret de signature des sessions (OBLIGATOIRE en production).
# Générer avec : openssl rand -hex 48
SESSION_SECRET=
SESSION_TTL_HOURS=8
# Passer à true derrière un reverse proxy HTTPS (cookie Secure).
SESSION_COOKIE_SECURE=false
# true uniquement derrière un reverse proxy de confiance (nginx, Traefik…).
TRUST_PROXY=false
LOG_LEVEL=info

# ── Active Directory / LDAP ─────────────────────────────────────────────────
LDAP_ENABLED=true
# ldaps://dc01.exemple.local:636 recommandé ; ldap:// + StartTLS possible.
LDAP_URL=ldaps://dc01.exemple.local:636
# Domaine utilisé pour construire l'UPN et l'email de repli.
LDAP_EMAIL_DOMAIN=exemple.local
# Suffixe UPN réellement utilisé par l'AD (souvent .lan), vide = LDAP_EMAIL_DOMAIN.
LDAP_BIND_DOMAIN=
# {username}@{domain} (UPN) ou {domain}\{username} (style NTLM)
LDAP_BIND_FORMAT={username}@{domain}
# Base de recherche pour relire le nom affiché et l'email.
LDAP_BASE_DN=DC=exemple,DC=local
LDAP_STARTTLS=true
# true = vérification stricte du certificat du DC (recommandé en production).
LDAP_TLS_STRICT=true
# Identifiants AD promus administrateurs dans la plateforme (séparés par des virgules).
LDAP_ADMIN_USERNAMES=
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_TIMEOUT_MS=12000

# ── Connexion locale de développement ───────────────────────────────────────
# Ignorée si NODE_ENV=production. À laisser false hors développement.
AUTH_DEV_LOGIN=false
AUTH_DEV_USER=dev
AUTH_DEV_PASSWORD=

# ── API SentinelOne Management ──────────────────────────────────────────────
# URL de la console, avec ou sans /web/api/v2.1 (normalisée automatiquement).
S1_URL=https://exemple.sentinelone.net
# Console → Paramètres → Utilisateurs → Token API (portée lecture suffisante).
S1_API_TOKEN=
S1_TIMEOUT_MS=15000
# Durée du cache mémoire (ms) pour ne pas saturer l'API SentinelOne.
S1_CACHE_TTL_MS=20000
# Taille de l'échantillon lu pour les KPI du dashboard (50 à 1000).
S1_SAMPLE_LIMIT=500
S1_PAGE_SIZE=25
# true uniquement si la console utilise un certificat interne non approuvé.
S1_TLS_INSECURE=false

# ── Migration Singularity Operations Center ─────────────────────────────────
# Bannière d'information sur le passage à Ops Center (retrait console legacy).
S1_MIGRATION_BANNER=true
# Dates ISO (AAAA-MM-JJ) — défauts : Ops Center par défaut 2026-11-02, retrait 2027-06-01.
S1_MIGRATION_DEFAULT_DATE=2026-11-02
S1_MIGRATION_RETIREMENT_DATE=2027-06-01
# Lien « En savoir plus » (vide = lien masqué).
S1_MIGRATION_DOC_URL=

# ── Limitation des tentatives de connexion ──────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── Base de données PostgreSQL (optionnelle) ────────────────────────────────
# Persistance de l'historique SOC (menaces, alertes, notes, activités) + socle RAG.
# Vide = la plateforme reste stateless (rien n'est stocké).
# Démarrer la DB locale : docker compose up -d
# Port 5435 : 5432 est déjà pris sur ce host (gestions_access_db).
DATABASE_URL=postgresql://soc:soc@127.0.0.1:5435/soc
DB_ENABLED=true
DB_POOL_MAX=5
# Synchro périodique depuis SentinelOne vers PostgreSQL.
DB_SYNC_ENABLED=true
DB_SYNC_INTERVAL_MIN=15
DB_SYNC_PAGE_SIZE=100
DB_SYNC_MAX_PAGES=5

# ── Embeddings / RAG ─────────────────────────────────────────────────────────
# Dimension du vecteur pgvector — figée à la 1re migration, ne pas changer
# sans recréer la colonne (les modèles/clés EMBEDDING viennent de la BDD).
EMBEDDINGS_DIM=1536

# ── IA : chat, RAG, voix (optionnel, nécessite DATABASE_URL) ─────────────────
# Les providers / clés API se configurent dans l'UI : Paramètres > IA (admin).
# Clés stockées en base, jamais en env, jamais réaffichées en clair.
AI_CHAT_ENABLED=true
AI_CHAT_DAILY_QUOTA=500
AI_CHAT_RATE_LIMIT=120
AI_MAX_TOOL_ROUNDS=6
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_RAG_INDEX_ENABLED=true
AI_DAILY_TOKEN_BUDGET=0
AI_TOKEN_ALERT_THRESHOLD=0.8

# Voix — live WS sur port dédié, batch STT/TTS + dictée
VOICE_ENABLED=true
VOICE_LIVE_PORT=3213
VOICE_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
VOICE_LIVE_VOICE=Aoede
VOICE_TTS_MODEL=gemini-2.5-flash-preview-tts
VOICE_TTS_VOICE=Kore
VOICE_STT_MODEL=gemini-2.5-flash
